FACTORY_DEF {*} RasterEvaluationFactory    FACTORY_NAME { ToDecibels }    INPUT A FEATURE_TYPE FeatureReader_GEOTIFF    INTERPRETATION_LIST "REAL32;REAL32;REAL32;REAL32" EXPRESSION_LIST "@if(A[0]>0,10*@log10(A[0]),-99);@if(A[1]>0,10*@log10(A[1]),-99);@if(A[2]>0,10*@log10(A[2]),-99);@if(A[3]>0,10*@log10(A[3]),-99)"    FORCE_FLOAT_DIVISION yes    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    ATTRIBUTE_ACCUMULATION_MODE { <Unused> }    ATTRIBUTE_CONFLICT_RESOLUTION { <Unused> }    REJECT_INVALID_FEATURES YES    OUTPUT { RESULT FEATURE_TYPE ToDecibels_RESULT          }    OUTPUT { <REJECTED> FEATURE_TYPE ToDecibels_<REJECTED>          }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME ToDecibels_<Rejected> INPUT FEATURE_TYPE ToDecibels_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, ToDecibels<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
