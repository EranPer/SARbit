#! <GLOBAL_PARAMETERS>
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI STRING_OR_ATTR MISSION Mission id (folder in /data/nisar/clips)"
#!   DEFAULT_VALUE="W2"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI STRING_OR_ATTR BEFORE Before date (for mission.json)"
#!   DEFAULT_VALUE="2026-01-05"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI STRING_OR_ATTR AFTER After date (for mission.json)"
#!   DEFAULT_VALUE="2026-01-17"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI STRING_OR_ATTR CHANNEL Change channel: 0 = co-pol (HH/VV), 1 = cross-pol (HV/VH)"
#!   DEFAULT_VALUE="0"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI STRING_OR_ATTR SIGN Direction: -1 = got darker, 1 = got brighter"
#!   DEFAULT_VALUE="-1"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI STRING_OR_ATTR THRESH_DB Minimum change in dB"
#!   DEFAULT_VALUE="3"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI STRING_OR_ATTR WATER_MAX After value must be below this dB (floods: -18; else 99 = off)"
#!   DEFAULT_VALUE="-18"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI STRING_OR_ATTR CO_NAME Co-pol channel name (HH, or VV)"
#!   DEFAULT_VALUE="HH"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI STRING_OR_ATTR CX_NAME Cross-pol channel name (HV, or VH; same as CO_NAME if missing)"
#!   DEFAULT_VALUE="HV"
#!   IS_STAND_ALONE="false"
#! />
#! </GLOBAL_PARAMETERS>
#! <USER_PARAMETERS
#!   FORM=""
#! >
#! <PARAMETER_INFO>
#!     <INFO NAME="MISSION" 
#!   DEFAULT_VALUE="W2"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI STRING_OR_ATTR MISSION Mission id (folder in /data/nisar/clips)"
#! />
#!     <INFO NAME="BEFORE" 
#!   DEFAULT_VALUE="2026-01-05"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI STRING_OR_ATTR BEFORE Before date (for mission.json)"
#! />
#!     <INFO NAME="AFTER" 
#!   DEFAULT_VALUE="2026-01-17"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI STRING_OR_ATTR AFTER After date (for mission.json)"
#! />
#!     <INFO NAME="CHANNEL" 
#!   DEFAULT_VALUE="0"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI STRING_OR_ATTR CHANNEL Change channel: 0 = co-pol (HH/VV), 1 = cross-pol (HV/VH)"
#! />
#!     <INFO NAME="SIGN" 
#!   DEFAULT_VALUE="-1"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI STRING_OR_ATTR SIGN Direction: -1 = got darker, 1 = got brighter"
#! />
#!     <INFO NAME="THRESH_DB" 
#!   DEFAULT_VALUE="3"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI STRING_OR_ATTR THRESH_DB Minimum change in dB"
#! />
#!     <INFO NAME="WATER_MAX" 
#!   DEFAULT_VALUE="-18"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI STRING_OR_ATTR WATER_MAX After value must be below this dB (floods: -18; else 99 = off)"
#! />
#!     <INFO NAME="CO_NAME" 
#!   DEFAULT_VALUE="HH"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI STRING_OR_ATTR CO_NAME Co-pol channel name (HH, or VV)"
#! />
#!     <INFO NAME="CX_NAME" 
#!   DEFAULT_VALUE="HV"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="true"
#!   GUI_LINE="GUI STRING_OR_ATTR CX_NAME Cross-pol channel name (HV, or VH; same as CO_NAME if missing)"
#! />
#! </PARAMETER_INFO>
#! </USER_PARAMETERS>
#! <COMMENTS>
#! <COMMENT
#!   IDENTIFIER="47"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;1 · TO DECIBELS. Radar brightness arrives as linear power (0.001 to 30). 10·log10 turns it into dB (about −30 to +5), the scale every radar rule and colour stretch below is written in. 4 bands in, 4 out. No signal (0) becomes −99 dB, so no NoData flag is needed anywhere.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="800 740"
#!   TOP_LEFT="800 740"
#!   BOTTOM_RIGHT="1500 180"
#!   BOUNDING_RECT="800 740 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{5e5a224c-cace-4dc5-b461-d9d0cfcb7244}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="5"
#! />
#! <COMMENT
#!   IDENTIFIER="48"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;2 · DESPECKLE. Radar images are grainy (&apos;speckle&apos;). A 5×5 median replaces each pixel by the middle value of its 25 neighbours: grain goes, edges (shorelines, field borders) stay sharp.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="1600 740"
#!   TOP_LEFT="1600 740"
#!   BOTTOM_RIGHT="2300 180"
#!   BOUNDING_RECT="1600 740 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{2683b5ad-3672-4eda-aa42-f258a5bd901f}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="6"
#! />
#! <COMMENT
#!   IDENTIFIER="49"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;3 · RESIZE to 1024 × 1024. The box is square in UTM, so it stays square. Plenty for the screen, small files for the web, same size for every mission.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="2400 740"
#!   TOP_LEFT="2400 740"
#!   BOTTOM_RIGHT="3100 180"
#!   BOUNDING_RECT="2400 740 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{a86be2fe-76f3-4cd1-9858-382f565bf6a7}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="7"
#! />
#! <COMMENT
#!   IDENTIFIER="50"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;4 · CHANGE MAP (adds band 5). Per pixel: difference after − before on the chosen channel (CHANNEL 0 = co-pol HH/VV, 1 = cross-pol HV/VH). Changed = 1 when SIGN × difference &amp;gt; THRESH_DB (SIGN −1 = got darker, +1 = got brighter) and the after value is below WATER_MAX (−18 for floods, 99 = off). Pixels without signal on either date never count.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="3200 740"
#!   TOP_LEFT="3200 740"
#!   BOTTOM_RIGHT="3900 180"
#!   BOUNDING_RECT="3200 740 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{ac8cb78a-5c58-4c00-9b14-716feaa54c10}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="8"
#! />
#! <COMMENT
#!   IDENTIFIER="51"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;5 · TO WEB MERCATOR (EPSG:3857), the projection of web maps. This is what makes the PNGs sit exactly on the Leaflet basemap. Everything after this point is output.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="4000 740"
#!   TOP_LEFT="4000 740"
#!   BOTTOM_RIGHT="4700 180"
#!   BOUNDING_RECT="4000 740 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{9f14bc81-ee73-4613-9579-0c47c404a748}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="9"
#! />
#! <COMMENT
#!   IDENTIFIER="52"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;6 · PAINT every picture into one 36-band raster (9 pictures × RGBA). Ready-made: before, after (R = co-pol, G = cross-pol, B = co-pol, one fixed stretch for both dates) and the red change overlay. Building blocks for the game: grey layers co-pol, cross-pol and co−cross ratio for each date, all on ONE fixed scale (−35…+5 dB, ratio 0…20 dB), so the player can mix them into R/G/B and the colours stay comparable.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="4800 2240"
#!   TOP_LEFT="4800 2240"
#!   BOTTOM_RIGHT="5500 1680"
#!   BOUNDING_RECT="4800 2240 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{9d619b92-059e-4115-8243-69934ae3be1f}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="10"
#! />
#! <COMMENT
#!   IDENTIFIER="53"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;7 · NINE COPIES, one per picture: 0 before · 1 after · 2 change · 3 before co · 4 before cross · 5 after co · 6 after cross · 7 before ratio · 8 after ratio.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="5600 2240"
#!   TOP_LEFT="5600 2240"
#!   BOTTOM_RIGHT="6300 1680"
#!   BOUNDING_RECT="5600 2240 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{7c55531f-684e-4c3a-8951-e6523ced784f}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="11"
#! />
#! <COMMENT
#!   IDENTIFIER="54"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;8 · WHICH BANDS. Copy n keeps bands 4n … 4n+3. Written as a band list for the next step.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="6400 2240"
#!   TOP_LEFT="6400 2240"
#!   BOTTOM_RIGHT="7100 1680"
#!   BOUNDING_RECT="6400 2240 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{4777d422-4acd-4a31-bec9-4ba2d690732c}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="12"
#! />
#! <COMMENT
#!   IDENTIFIER="55"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;9 · MARK the 4 bands of this copy (RasterSelector only marks, it doesn&apos;t remove).&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="7200 2240"
#!   TOP_LEFT="7200 2240"
#!   BOTTOM_RIGHT="7900 1680"
#!   BOUNDING_RECT="7200 2240 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{d895308e-fbb6-403a-b5cb-09a7a4174b31}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="13"
#! />
#! <COMMENT
#!   IDENTIFIER="56"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;10 · KEEP only the marked bands = one RGBA picture per copy, ready for PNG.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="8000 2240"
#!   TOP_LEFT="8000 2240"
#!   BOTTOM_RIGHT="8700 1680"
#!   BOUNDING_RECT="8000 2240 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{f27ce861-a96c-499b-84cf-933c83f80e30}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="14"
#! />
#! <COMMENT
#!   IDENTIFIER="57"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;11 · CUT INTO 12 × 12 TILES: the game board. Each tile keeps its _tile_row / _tile_column.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="4800 740"
#!   TOP_LEFT="4800 740"
#!   BOTTOM_RIGHT="5500 180"
#!   BOUNDING_RECT="4800 740 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{23049cc0-726f-4c27-8a77-59a49fb3144e}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="15"
#! />
#! <COMMENT
#!   IDENTIFIER="58"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;12 · SHARE CHANGED. Mean of band 5 (0/1) over the tile = the fraction of its pixels that changed (band4.mean).&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="5600 740"
#!   TOP_LEFT="5600 740"
#!   BOTTOM_RIGHT="6300 180"
#!   BOUNDING_RECT="5600 740 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{abf4f84c-5a81-4a36-8c22-befd17d79034}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="16"
#! />
#! <COMMENT
#!   IDENTIFIER="59"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;13 · TILE → CELL. Swap each raster tile for its outline polygon: the clickable square in the game.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="6400 740"
#!   TOP_LEFT="6400 740"
#!   BOTTOM_RIGHT="7100 180"
#!   BOUNDING_RECT="6400 740 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{e510827e-5a3e-4a2a-bea6-57804e20e275}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="17"
#! />
#! <COMMENT
#!   IDENTIFIER="60"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;14 · HIT OR NOT. hit = 1 when at least 20 % of the cell changed: the answer key the player&apos;s guess is scored against. row / col say where the cell sits.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="7200 740"
#!   TOP_LEFT="7200 740"
#!   BOTTOM_RIGHT="7900 180"
#!   BOUNDING_RECT="7200 740 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
