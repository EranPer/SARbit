FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { Resize1024_RasterResampler }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE Despeckle5x5Median_OUTPUT    FUNCTION_DEFINITION { @ResampleRaster(REJECTABLE,$(RESAMPLE_ARGS)) }    OUTPUT { COMPLETE FEATURE_TYPE Resize1024_RESAMPLED        }    OUTPUT { REJECTED FEATURE_TYPE Resize1024_<REJECTED>        }
