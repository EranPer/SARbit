FACTORY_DEF {*} RasterEvaluationFactory    FACTORY_NAME { ChangeMap }    INPUT A FEATURE_TYPE Resize1024_RESAMPLED    INTERPRETATION_LIST "REAL32;REAL32;REAL32;REAL32;UINT8" EXPRESSION_LIST "A[0];A[1];A[2];A[3];@if((A[0]>-90)&&(A[2]>-90)&&($(SIGN$encode)*@if($(CHANNEL$encode)==0,A[2]-A[0],A[3]-A[1])>$(THRESH_DB$encode))&&(@if($(CHANNEL$encode)==0,A[2],A[3])<$(WATER_MAX$encode)),1,0)"    FORCE_FLOAT_DIVISION yes    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    ATTRIBUTE_ACCUMULATION_MODE { <Unused> }    ATTRIBUTE_CONFLICT_RESOLUTION { <Unused> }    REJECT_INVALID_FEATURES YES    OUTPUT { RESULT FEATURE_TYPE ChangeMap_RESULT          }    OUTPUT { <REJECTED> FEATURE_TYPE ChangeMap_<REJECTED>          }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
