#!   IDENTIFIER="63"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;17 · TO LAT/LON. Leaflet places an image by its corner latitudes/longitudes.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="5600 -760"
#!   TOP_LEFT="5600 -760"
#!   BOTTOM_RIGHT="6300 -1320"
#!   BOUNDING_RECT="5600 -760 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
#!   INFO_NODE="false"
#!   CUSTOM_USER_COLOR="false"
#!   UUID="{24d478ca-9963-40bb-b93e-5f564c518f10}"
#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="21"
#! />
#! <COMMENT
#!   IDENTIFIER="64"
