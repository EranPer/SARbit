FME_PYTHON_VERSION 312
ARCGIS_COMPATIBILITY ARCGIS_AUTO
# ============================================================================
DEFAULT_MACRO MISSION W2
DEFAULT_MACRO BEFORE 2026-01-05
DEFAULT_MACRO AFTER 2026-01-17
DEFAULT_MACRO CHANNEL 0
DEFAULT_MACRO SIGN -1
DEFAULT_MACRO THRESH_DB 3
DEFAULT_MACRO WATER_MAX -18
DEFAULT_MACRO CO_NAME HH
DEFAULT_MACRO CX_NAME HV
# ============================================================================
INCLUDE [ if {{$(MISSION$encode)} == {}} { puts_real {Parameter 'MISSION' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(BEFORE$encode)} == {}} { puts_real {Parameter 'BEFORE' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(AFTER$encode)} == {}} { puts_real {Parameter 'AFTER' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(CHANNEL$encode)} == {}} { puts_real {Parameter 'CHANNEL' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(SIGN$encode)} == {}} { puts_real {Parameter 'SIGN' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(THRESH_DB$encode)} == {}} { puts_real {Parameter 'THRESH_DB' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(WATER_MAX$encode)} == {}} { puts_real {Parameter 'WATER_MAX' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(CO_NAME$encode)} == {}} { puts_real {Parameter 'CO_NAME' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(CX_NAME$encode)} == {}} { puts_real {Parameter 'CX_NAME' must be given a value.}; exit 1; }; ]
#! START_HEADER
#! START_WB_HEADER
READER_TYPE MULTI_READER
WRITER_TYPE MULTI_WRITER
WRITER_KEYWORD MULTI_DEST
MULTI_DEST_DATASET null
#! END_WB_HEADER
#! START_WB_HEADER
#! END_WB_HEADER
#! END_HEADER

LOG_FILENAME "$(FME_MF_DIR)$(WORKSPACE_NAME).log"
LOG_APPEND NO
LOG_MAX_FEATURES 200
LOG_MAX_RECORDED_FEATURES 200
FME_REPROJECTION_ENGINE FME
FME_IMPLICIT_CSMAP_REPROJECTION_MODE Auto
FME_GEOMETRY_HANDLING Enhanced
FME_STROKE_MAX_DEVIATION 0
FME_NAMES_ENCODING US-ASCII
FME_BULK_MODE_THRESHOLD 2000
LAST_SAVE_BUILD "0.1"
# -------------------------------------------------------------------------

MULTI_READER_CONTINUE_ON_READER_FAILURE No

# -------------------------------------------------------------------------

MACRO FME_VIEWER_APP fmedatainspector
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
MACRO FeatureReader_OUTPUT_PORTS_ENCODED GEOTIFF
MACRO FeatureReader_DIRECTIVES APPLY_GCPS,NO,COORDINATE_SYSTEM,,EXPOSE_ATTRS_GROUP,,FEATURE_TYPE_NAME,FORMAT_NAME,GEOTIFF_EXPOSE_FORMAT_ATTRS,,GEOTIFF_RDR_ADV_PARM_GROUP,,IGNORE_RASTER_TYPE_KEY,No,LENIENT_READ,Yes,NATIVELY_HANDLED_WEBSERVICES,s3connector<comma>azurestorage<comma>google-cloud-storage,PREFER_FILE_CS_UNITS,Yes,PYRAMID_LEVEL,,READ_OFFSETS_IN_CS_UNITS,No,READER_META_ATTRIBUTES,fme_dataset<space>fme_basename,SCALE_COLOR_TO_STANDARD_BIT_DEPTH,YES,SPATIAL_GROUP,,USE_APPROXIMATE_WORLDFILES,no,USE_SEARCH_ENVELOPE,NO
# Consolidate the attribute merge options to what the factory expects
DEFAULT_MACRO FeatureReader_COMBINE_ATTRS
INCLUDE [       if { {<Unused>} == {MERGE} } {          puts "MACRO FeatureReader_COMBINE_ATTRS <Unused>";       } else {          puts "MACRO FeatureReader_COMBINE_ATTRS <Unused>";       };    ]
INCLUDE [    puts {DEFAULT_MACRO FeatureReaderDataset_FeatureReader @EvaluateExpression(FDIV,STRING_ENCODED,<solidus>data<solidus>nisar<solidus>clips<solidus>$(MISSION$encode)<solidus>stack.tif,FeatureReader)}; ]
FACTORY_DEF {*} CreationFactory    FACTORY_NAME { FeatureReader_Creator }    OUTPUT { FEATURE_TYPE FeatureReader_____CREATED______ }
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { FeatureReader }    INPUT { FEATURE_TYPE FeatureReader_____CREATED______ }    FCTQUERY_INTERACTION_TOCHECK { "NONE" "NONE" }    CLIP_TO_INITIATOR_ENVELOPE { "NO" }    COMBINE_ATTRIBUTES  { $(FeatureReader_COMBINE_ATTRS) }    IGNORE_NULLS        { <Unused> }    REJECT_POINTS       { YES }    QUERYFCT_ATTRIBUTE_PREFIX { <Unused> }    COMBINE_GEOMETRY    { <Unused> }    ENABLE_CACHE        { NO }    QUERYFCT_TABLE_SEPARATOR { SPACE }    READER_TYPE         { GEOTIFF  }    READER_DATASET      { "$(FeatureReaderDataset_FeatureReader)" }    QUERYFCT_IDS        { "" }    QUERYFCT_IDS_FORMAT WWJD_PARTS    READER_DIRECTIVES   { METAFILE,GEOTIFF }    QUERYFCT_OUTPUT     { "BASED_ON_CONNECTIONS" }    QUERYFCT_ADD_SCHEMA { "NO" }    QUERYFCT_USE_SCHEMA_CACHE { "YES" }    QUERYFCT_INITIATOR_FIRST_OUTPUT { "default" }    QUERYFCT_DEDUPE_GEOM YES    CONTINUE_ON_READER_ERROR YES    ORDER_RESULTS { "No" }    QUERYFCT_RESULT_TAGS { $(FeatureReader_OUTPUT_PORTS_ENCODED) }    QUERYFCT_SET_FME_FEATURE_TYPE YES    QUERYFCT_SET_FME_META_ATTRS YES    READER_PARAMS_WWJD     { $(FeatureReader_DIRECTIVES) }    TREAT_READER_PARAM_AMPERSANDS_AS_LITERALS YES    HONOR_INITIATOR_COORDSYS YES    OUTPUT { READER_ERROR FEATURE_TYPE FeatureReader_<REJECTED>           }    OUTPUT GEOTIFF FEATURE_TYPE FeatureReader_GEOTIFF
FACTORY_DEF * BranchingFactory   FACTORY_NAME "FeatureReader_GEOTIFF Brancher -1 25"   INPUT FEATURE_TYPE FeatureReader_GEOTIFF   TARGET_FACTORY "$(WB_CURRENT_CONTEXT)_CREATOR_BRANCH_TARGET"   MAXIMUM_COUNT None   OUTPUT PASSED FEATURE_TYPE *
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME FeatureReader_<Rejected> INPUT FEATURE_TYPE FeatureReader_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, FeatureReader<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
