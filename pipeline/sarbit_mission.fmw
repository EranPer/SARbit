#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="19"
#! />
#! <COMMENT
#!   IDENTIFIER="62"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;16 · FOOTPRINT. The outline of the finished image (still Web Mercator).&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="4800 -760"
#!   TOP_LEFT="4800 -760"
#!   BOTTOM_RIGHT="5500 -1320"
#!   BOUNDING_RECT="4800 -760 700 560"
#!   ORDER="500000000000000"
