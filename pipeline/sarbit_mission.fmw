#!   COLOUR="1,0.95686274509803926,0.80000000000000004,0.90196078431372551"
#!   SIZE_POLICY="10"
#!   ANCHORED_NODE="18"
#! />
#! <COMMENT
#!   IDENTIFIER="61"
#!   COMMENT_VALUE="&lt;html&gt;&lt;body&gt;15 · TO LAT/LON (EPSG:4326), what GeoJSON and Leaflet expect for vector shapes.&lt;/body&gt;&lt;/html&gt;"
#!   POSITION="8000 740"
#!   TOP_LEFT="8000 740"
#!   BOTTOM_RIGHT="8700 180"
#!   BOUNDING_RECT="8000 740 700 560"
#!   ORDER="500000000000000"
#!   FOLLOW_ANCHOR="true"
